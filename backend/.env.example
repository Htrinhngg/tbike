# Backend T-Bike - KHONG commit file .env that.
# Chuoi ket noi Postgres cua Supabase (Project Settings > Database).
# Dung "Direct connection" hoac "Session pooler" (port 5432). Backend tat prepared statements nen
# Transaction pooler (6543) cung chay duoc.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<host>:5432/postgres
# Dung de backend xac minh access token qua Supabase Auth (GET /auth/v1/user)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Nguon frontend duoc phep goi API (phan tach bang dau phay)
CORS_ORIGINS=http://localhost:5173
# Gioi han goi API cong khai (gui yeu cau / tra cuu) moi IP moi phut
PUBLIC_RATE_LIMIT_PER_MINUTE=20
# Chi cho test tich hop tren Postgres cuc bo (xem README) - KHONG tro toi Supabase that
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tbike_test
